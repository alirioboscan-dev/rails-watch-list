<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Add a new movie</h1>

      <%= simple_form_for @movie do |f| %>
        <%= f.input :title, placeholder: "e.g. The Godfather", required: false %>
        <%= f.input :overview, as: :text, placeholder: "Brief description of the movie...", required: false %>
        <%= f.input :poster_url, label: "Poster URL", placeholder: "https://...", required: false %>
        <%= f.input :rating, placeholder: "e.g. 8.5", required: false %>
        <%= f.submit "Add movie", class: "btn btn-success" %>
      <% end %>

      <%= link_to "← Back to movies", movies_path, class: "btn btn-link mt-2" %>
    </div>
  </div>
</div>
