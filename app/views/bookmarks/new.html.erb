<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Add a movie to <%= @list.name %></h1>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie, collection: @movies, label_method: :title, value_method: :id, prompt: "Select a movie" %>
        <%= f.input :comment, placeholder: "Why do you recommend it?" %>
        <%= f.submit "Add to list", class: "btn btn-success" %>
      <% end %>

      <%= link_to "← Back to list", list_path(@list), class: "btn btn-link mt-2" %>
    </div>
  </div>
</div>
