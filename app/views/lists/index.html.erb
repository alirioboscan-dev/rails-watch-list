<div class="hero mb-5" style="background-image: url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1600');">
  <div class="hero-content">
    <h1>Save any kind of movies</h1>
    <p>Your personal watch list, all in one place.</p>
  </div>
</div>

<div class="container mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Lists</h2>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
  </div>

  <% default_image = "https://images.unsplash.com/photo-1524712245354-2c4e5e7121c0?w=800" %>

  <div class="row g-4">
    <% @lists.each do |list| %>
      <div class="col-md-4">
        <%= link_to list_path(list), class: "text-decoration-none" do %>
          <div class="list-card" style="background-image: url('<%= list.image_url.presence || default_image %>');">
            <p class="list-card-title"><%= list.name %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
