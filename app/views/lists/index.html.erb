<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Lists</h1>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
  </div>

  <div class="row g-4">
    <% @lists.each do |list| %>
      <div class="col-md-4">
        <%= link_to list_path(list), class: "text-decoration-none" do %>
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title text-dark"><%= list.name %></h5>
              <p class="text-muted"><%= list.movies.count %> movies</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
