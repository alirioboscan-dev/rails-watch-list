<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Edit <%= @list.name %></h1>

      <%= simple_form_for @list do |f| %>
        <%= f.input :name, placeholder: "e.g. Drama, Classics...", required: false %>
        <%= f.input :image_url, label: "Cover image URL", placeholder: "https://..." %>
        <%= f.submit "Save changes", class: "btn btn-success" %>
      <% end %>

      <%= link_to "← Back to list", list_path(@list), class: "btn btn-link mt-2" %>
    </div>
  </div>
</div>
