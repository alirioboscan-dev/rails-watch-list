<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @list.name %></h1>
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success" %>
  </div>

  <% if @list.bookmarks.empty? %>
    <p class="text-muted">No movies in this list yet.</p>
  <% else %>
    <div class="row g-4">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <img src="<%= bookmark.movie.poster_url %>" class="card-img-top" alt="<%= bookmark.movie.title %>">
            <div class="card-body">
              <h5 class="card-title"><%= bookmark.movie.title %></h5>
              <p class="text-muted">⭐ <%= bookmark.movie.rating %></p>
              <% if bookmark.comment.present? %>
                <p class="fst-italic">"<%= bookmark.comment %>"</p>
              <% end %>
            </div>
            <div class="card-footer text-end">
              <%= link_to "delete", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-danger text-decoration-none" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
