<% default_image = "https://images.unsplash.com/photo-1524712245354-2c4e5e7121c0?w=1600" %>

<div class="hero mb-5" style="background-image: url('<%= @list.image_url.presence || default_image %>');">
  <div class="hero-content d-flex justify-content-between align-items-end w-100">
    <div>
      <h1><%= @list.name %></h1>
      <p><%= @list.movies.count %> movies</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "✏️ Edit list", edit_list_path(@list), class: "btn btn-outline-light btn-sm", style: "width: 120px;" %>
      <button class="btn btn-outline-light btn-sm" id="share-btn" onclick="copyListUrl()" style="width: 120px;">
       🔗 Share list
      </button>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row mb-5">

    <%# Columna izquierda: películas %>
    <div class="col-md-8">
      <% if @list.bookmarks.empty? %>
        <p class="text-muted">No movies in this list yet. Add your first one!</p>
      <% else %>
        <div class="row g-4">
          <% @list.bookmarks.each do |bookmark| %>
            <div class="col-md-6">
              <div class="card movie-card h-100">
                <img src="<%= bookmark.movie.poster_url %>" alt="<%= bookmark.movie.title %>">
                <div class="card-body">
                  <h5 class="card-title">
                    <%= bookmark.movie.title %>
                    <span class="text-muted fs-6">· <%= bookmark.movie.rating %> ⭐</span>
                  </h5>
                  <p class="text-muted small"><%= bookmark.movie.overview.truncate(100) %></p>
                  <% if bookmark.comment.present? %>
                    <p class="movie-comment"><%= bookmark.comment %></p>
                  <% end %>
                </div>
                <div class="card-footer bg-white border-0 text-end">
                  <%= link_to "delete", bookmark_path(bookmark),
                        data: { turbo_method: :delete, turbo_confirm: "Remove this movie?" },
                        class: "delete-link" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Columna derecha: formulario bookmark %>
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <h5 class="mb-3">Add a movie</h5>
          <%= simple_form_for [@list, @bookmark] do |f| %>
          <%# Campo oculto que guarda el movie_id seleccionado %>
          <%= f.hidden_field :movie_id, id: "bookmark_movie_id" %>

      <%# Input de búsqueda visible %>
      <div class="mb-3">
        <label class="form-label">Movie</label>
        <input
          type="text"
          id="movie-search-input"
          class="form-control"
          placeholder="Search by title..."
          autocomplete="off"
        />
        <%# Dropdown de resultados %>
        <div id="movie-search-results" class="list-group mt-1" style="display:none; position:absolute; z-index:100; width:90%;"></div>
      </div>

      <%= f.input :comment, placeholder: "Why do you recommend it?", required: false %>
      <%= f.submit "Add to list", class: "btn btn-success w-100" %>
    <% end %>
  </div>
</div>

  </div>

  <hr class="my-5">

  <%# Sección de reviews %>
  <div class="row">

    <%# Reviews existentes %>
    <div class="col-md-7">
      <h4 class="mb-4">Reviews</h4>
      <% if @reviews.empty? %>
        <p class="text-muted">No reviews yet. Be the first!</p>
      <% else %>
        <% @reviews.each do |review| %>
          <div class="review-card">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <span class="stars"><%= render "reviews/stars", rating: review.rating %></span>
                <span class="review-meta ms-2"><%= time_ago_in_words(review.created_at) %> ago</span>
                <p class="mt-2 mb-0"><%= review.comment %></p>
              </div>
              <%= link_to "delete",
                    list_review_path(@list, review),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this review?" },
                    class: "delete-link ms-3" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Formulario de nueva review %>
    <div class="col-md-4 offset-md-1">
      <div class="card shadow-sm p-3">
        <h5 class="mb-3">Add your review</h5>
        <%= simple_form_for [@list, @review] do |f| %>
          <%= f.input :comment, label: "Comment", placeholder: "Add your review here...", required: false %>

          <div class="mb-3">
            <label class="form-label">Rating</label>
            <div class="star-rating">
              <% 5.downto(1) do |i| %>
                <%= f.radio_button :rating, i, id: "rating_#{i}" %>
                <label for="rating_<%= i %>">★</label>
              <% end %>
            </div>
          </div>

          <%= f.submit "Create Review", class: "btn btn-success w-100" %>
        <% end %>
      </div>
    </div>

  </div>
</div>

<script>
  function copyListUrl() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const btn = document.getElementById("share-btn");
      btn.innerText = "✅ Link copied!";
      setTimeout(() => btn.innerText = "🔗 Share list", 2000);
    });
  }

  document.addEventListener("turbo:load", function () {
    const searchInput  = document.getElementById("movie-search-input");
    const resultsBox   = document.getElementById("movie-search-results");
    const movieIdField = document.getElementById("bookmark_movie_id");

    if (!searchInput) return;

    searchInput.addEventListener("input", function () {
      const query = this.value.trim();

      if (query.length < 2) {
        resultsBox.style.display = "none";
        resultsBox.innerHTML = "";
        return;
      }

      fetch(`/movies/search?query=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(movies => {
          resultsBox.innerHTML = "";

          if (movies.length === 0) {
            resultsBox.innerHTML = `<div class="list-group-item text-muted">No results found</div>`;
            resultsBox.style.display = "block";
            return;
          }

          movies.forEach(movie => {
            const item = document.createElement("button");
            item.type = "button";
            item.className = "list-group-item list-group-item-action d-flex align-items-center gap-2";
            item.innerHTML = `
              <img src="${movie.poster_url}" style="width:36px; height:54px; object-fit:cover; border-radius:4px;">
              <span>${movie.title} <small class="text-muted">⭐ ${movie.rating}</small></span>
            `;
            item.addEventListener("click", function () {
              movieIdField.value = movie.id;
              searchInput.value = movie.title;
              resultsBox.style.display = "none";
            });
            resultsBox.appendChild(item);
          });

          resultsBox.style.display = "block";
        });
    });

    document.addEventListener("click", function (e) {
      if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
        resultsBox.style.display = "none";
      }
    });
  });
</script>
